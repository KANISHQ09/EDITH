{
  "name": "voice-ai-incident-commander",
  "version": "1.0.0",
  "description": "Voice AI Incident Commander — Real-Time AI-Powered Incident Management Co-Pilot",
  "private": true,
  "workspaces": [
    "services/api",
    "services/audio-ingestion",
    "services/incident-state-manager",
    "services/tool-integration-gateway",
    "services/websocket-gateway",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev:services",
    "dev:services": "concurrently --names \"api,ism,wsg\" \"node services/api/dist/index.js\" \"node services/incident-state-manager/dist/index.js\" \"node services/websocket-gateway/dist/index.js\"",
    "dev:watch": "concurrently --names \"api,ism,wsg\" \"npm run dev --workspace=services/api\" \"npm run dev --workspace=services/incident-state-manager\" \"npm run dev --workspace=services/websocket-gateway\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "seed": "node scripts/seed-demo.js",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present -- --passWithNoTests",
    "test:unit": "npm run test:unit --workspaces --if-present -- --passWithNoTests",
    "test:integration": "npm run test:integration --workspaces --if-present -- --passWithNoTests",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build --workspace=shared && npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate --workspace=services/api",
    "migrate:rollback": "npm run migrate:rollback --workspace=services/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
