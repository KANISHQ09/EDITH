# ──────────────────────────────────────────────────────────────
# Transcription Engine — Production Dockerfile
# Two-stage build: GPU-capable (CUDA 12.1 + Torch 2.3)
# For CPU-only dev: build with --build-arg DEVICE=cpu
# ──────────────────────────────────────────────────────────────
ARG DEVICE=gpu

# ── GPU Stage ────────────────────────────────────────────────
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04 as gpu-base
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    python3.11 python3.11-pip python3.11-dev \
    libsndfile1 ffmpeg git curl \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/pip3 pip3 /usr/bin/pip3.11 1

# Install PyTorch with CUDA
RUN pip3 install --no-cache-dir torch==2.3.1 torchaudio==2.3.1 --index-url https://download.pytorch.org/whl/cu121

# ── CPU Stage ────────────────────────────────────────────────
FROM python:3.11-slim as cpu-base
RUN apt-get update && apt-get install -y libsndfile1 ffmpeg && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.3.1 torchaudio==2.3.1 --index-url https://download.pytorch.org/whl/cpu

# ── Common ───────────────────────────────────────────────────
FROM ${DEVICE}-base as final

WORKDIR /app

# Cache Whisper + pyannote model downloads in layer
# Adjust WHISPER_MODEL for smaller dev builds (tiny, base, small)
ARG WHISPER_MODEL=large-v3
ARG HF_TOKEN=""

# Install dependencies first (layer-cached)
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Pre-download Whisper model weights into the image layer
# This avoids slow cold starts on pod init
RUN python3 -c "from faster_whisper import WhisperModel; WhisperModel('${WHISPER_MODEL}', device='cpu', compute_type='int8')"

# Copy source
COPY src/ ./src/
COPY . .

# Set model cache directory
ENV TRANSFORMERS_CACHE=/app/.cache/huggingface
ENV HF_HOME=/app/.cache/huggingface
ENV WHISPER_MODEL=${WHISPER_MODEL}
ENV HF_TOKEN=${HF_TOKEN}

# Health check — models must be loaded
HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:${TRANSCRIPTION_ENGINE_PORT:-8002}/ready || exit 1

EXPOSE 8002

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8002", "--workers", "1"]
