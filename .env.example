# ============================================================
# Voice AI Incident Commander — Environment Configuration
# ============================================================
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.

# --- Application ---
NODE_ENV=development
LOG_LEVEL=debug
ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# --- API Service ---
API_PORT=3001
API_BASE_URL=http://localhost:3001
JWT_SECRET=change-me-in-production-use-at-least-32-chars
JWT_EXPIRY=24h

# --- WebSocket Gateway ---
WSG_PORT=3002

# --- Incident State Manager ---
ISM_PORT=3003

# --- Tool Integration Gateway ---
TIG_PORT=3004

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vaic
POSTGRES_USER=vaic
POSTGRES_PASSWORD=vaic_local_dev_password
DATABASE_URL=postgresql://vaic:vaic_local_dev_password@localhost:5432/vaic

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Apache Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=vaic-local
KAFKA_GROUP_ID_API=vaic-api-group
KAFKA_GROUP_ID_ISM=vaic-ism-group
KAFKA_GROUP_ID_NCE=vaic-nce-group
KAFKA_GROUP_ID_TDE=vaic-tde-group
KAFKA_GROUP_ID_CDM=vaic-cdm-group
KAFKA_GROUP_ID_VSE=vaic-vse-group
KAFKA_GROUP_ID_TIG=vaic-tig-group
KAFKA_GROUP_ID_WSG=vaic-wsg-group

# --- Primary AI Provider (Google Gemini) ---
# Replaces Anthropic + OpenAI with single free API key
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Anthropic (Claude API) [Optional / Alternative] ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (Embeddings) [Optional / Alternative] ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- ElevenLabs TTS ---
# Required for: Voice Synthesis Engine
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=your-vaic-voice-id-here

# --- AWS Polly (TTS Fallback) ---
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
POLLY_VOICE_ID=Joanna

# --- Agora RTE (Audio Ingestion + TTS injection) ---
# Required for: Audio Ingestion Service, Voice Synthesis Engine
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
AGORA_CUSTOMER_KEY=your-agora-restful-api-key       # For Cloud Recording REST API
AGORA_CUSTOMER_SECRET=your-agora-restful-api-secret
AGORA_CLOUD_RECORDING_BUCKET=vaic-audio-raw          # S3 bucket for raw audio backup
AGORA_TOKEN_EXPIRY_S=86400                           # Bot token TTL (24h)
AGORA_BOT_UID=1000                                   # Fixed UID for the VAIC bot in every channel
AGORA_AUDIO_SAMPLE_RATE=16000                        # 16kHz PCM required by Whisper
AGORA_AUDIO_CHANNELS=1                               # Mono

# --- Slack ---
# Required for: Tool Integration Gateway
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_INCIDENT_CHANNEL=#incidents
SLACK_ISR_CHANNEL=#incident-reports

# --- Jira (v1.5) ---
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=INC

# --- PagerDuty (v1.5) ---
PAGERDUTY_API_KEY=your-pagerduty-api-key
PAGERDUTY_SERVICE_ID=your-pagerduty-service-id

# --- Datadog (v1.5) ---
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# --- Python Services (Classification Engine, Transcription Engine, etc.) ---
PYTHON_SERVICES_HOST=localhost
CLASSIFICATION_ENGINE_PORT=8001
TRANSCRIPTION_ENGINE_PORT=8002
CONFLICT_DETECTOR_PORT=8003
VOICE_SYNTHESIS_PORT=8004
REPORT_GENERATOR_PORT=8005

# --- Feature Flags ---
ENABLE_AUDIO_INGESTION=false      # Set true when Agora credentials are configured
ENABLE_TTS=false                  # Set true when ElevenLabs/Polly is configured
ENABLE_SLACK=false                # Set true when Slack bot token is configured
ENABLE_JIRA=false                 # v1.5
ENABLE_PAGERDUTY=false            # v1.5
ENABLE_DATADOG=false              # v1.5
MOCK_AUDIO_MODE=true              # Use mock audio fixtures (WAV files) instead of live Agora
AGORA_AUDIO_PERSIST=false        # Mirror of AUDIO_PERSIST for Agora Cloud Recording
MOCK_LLM_MODE=false               # Use mock LLM responses (set true to avoid API costs in dev)

# --- Whisper ASR ---
WHISPER_MODEL=large-v3            # Options: tiny, base, small, medium, large-v3
WHISPER_DEVICE=cpu                # Options: cpu, cuda
WHISPER_COMPUTE_TYPE=int8         # Options: int8 (cpu), float16 (gpu)

# --- LLM Context Window ---
LLM_CONTEXT_WINDOW_SIZE=50        # Number of transcript entries in context
CLASSIFICATION_TIMEOUT_MS=5000    # Max ms to wait for Claude response

# --- Summary Intervals ---
SUMMARY_INTERVAL_MINUTES=15       # How often VAIC delivers spoken status summaries
UNRESOLVED_QUESTION_TIMEOUT_MIN=5 # Mark questions as unresolved after N minutes

# --- Retention ---
TRANSCRIPT_RETENTION_DAYS=90
AUDIO_PERSIST=false               # Default: audio NOT persisted (GDPR)
