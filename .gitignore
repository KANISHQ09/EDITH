# ===========================
# VAIC Monorepo .gitignore
# ===========================

# Environment & secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
vault-token

# Node.js
node_modules/
dist/
build/
.next/
out/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# ML models (large binary files — download at runtime)
*.pt
*.bin
*.safetensors
models/

# Docker
.docker/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
logs/
*.log
*.log.*

# Test artifacts
test-results/
playwright-report/
k6-results/

# Infrastructure
infrastructure/terraform/.terraform/
infrastructure/terraform/**/*.tfstate
infrastructure/terraform/**/*.tfstate.backup
infrastructure/terraform/**/*.tfvars
!infrastructure/terraform/**/*.tfvars.example
.terraformrc
terraform.rc

# Audio fixtures (large files — store in Git LFS or S3)
tests/audio-fixtures/*.wav
tests/audio-fixtures/*.mp3
tests/audio-fixtures/*.pcm

# Generated reports
*.pdf
reports/

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V3
.Trashes
ehthumbs.db
Desktop.ini
